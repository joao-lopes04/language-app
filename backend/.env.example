DATABASE_URL=sqlite:///./japanese_study.db
# Required in production — use a long random string (openssl rand -hex 32)
SECRET_KEY=dev-only-change-me-in-production
# Comma-separated browser origins allowed to call the API (include your deployed frontend URL)
# Example: https://language-app.pages.dev,http://localhost:5173
# Or JSON: ["https://language-app.pages.dev","http://localhost:5173"]
CORS_ORIGINS=http://localhost:5173
# Comma-separated emails that see the admin user list in Profile (passwords never exposed)
ADMIN_EMAILS=
# Local dev only: return reset token in forgot-password JSON (never on public Render)
EXPOSE_PASSWORD_RESET_TOKEN=false
